  "datasets": [
    {
      "id": "ActiveRolesAdmins",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "target": "Objects",
        "base": "{DefaultADDN}",
        "filter": "{ConfigFilter:ActiveRolesAdmins}",
        "objects": [
          "APP-ACTIVEROLES-ADMINS"
        ]
      },
      "attributes": [
        "name",
        "distinguishedName"
      ]
    },
    {
      "id": "Servers",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Server Configuration,CN=Configuration",
        "filter": "(objectClass=edsARService)"
      },
      "attributes": [
        "edsaEdmServiceComputerName",
        "edsvaPublicProductVersion",
        "edsvaDiagnosticLogTurnedOn"
      ]
    },
    {
      "id": "Domains",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Managed Domains,CN=Server Configuration,CN=Configuration",
        "filter": "(objectClass=edsDomainCacheConfig)"
      },
      "attributes": [
        "name",
        "edsvaDomainDNS",
        "edsaSavedDnsName",
        "edsaUseOverrideAccount"
      ]
    },
    {
      "id": "AccessTemplateLinks",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=AT Links,CN=Configuration",
        "filter": "(objectClass=edsACE)"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "edsaTrusteeSID",
        "edsaSecObjectGUID",
        "edsaAccessTemplateGUID",
        "edsaIsPredefined",
        "edsaSystemObject"
      ]
    },
    {
      "id": "AccessTemplates",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Access Templates,CN=Configuration",
        "filter": "(objectClass=edsAccessTemplate)"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "edsvaParentCanonicalName",
        "edsaIsPredefined",
        "edsaSystemObject"
      ]
    },
    {
      "id": "ManagedUnits",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Managed Units,CN=Configuration",
        "filter": "(objectClass=edsManagedUnit)"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "edsaMUConditionsList"
      ]
    },
    {
      "id": "PolicyObjectLinks",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=AP Links,CN=Configuration",
        "filter": "(objectClass=edsPolicyObjectLink)"
      },
      "attributes": [
        "name",
        "distinguishedName"
      ]
    },
    {
      "id": "PolicyObjects",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Policies,CN=Configuration",
        "filter": "(objectClass=edsPolicyObject)"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "edsaAPEListXML",
        "edsaIsPredefined",
        "edsaSystemObject"
      ]
    },
    {
      "id": "VirtualAttributes",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Virtual Attributes,CN=Server Configuration,CN=Configuration",
        "filter": "(objectClass=edsVirtualAttribute)"
      },
      "attributes": [
        "name",
        "lDAPDisplayName",
        "isSingleValued",
        "edsaIsPredefined",
        "edsaSystemObject"
      ]
    },
    {
      "id": "Workflows",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Workflow,CN=Policies,CN=Configuration",
        "filter": "(|(objectClass=edsWorkflowDefinition)(objectClass=edsAutomationWorkflowDefinition))"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "objectClass",
        "edsaWorkflowIsDisabled"
      ]
    },
    {
      "id": "ConfigDatabases",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Configuration Databases,CN=Server Configuration,CN=Configuration",
        "filter": "(objectClass=edsReplicationPartner)"
      },
      "attributes": [
        "edsaSQLAlias",
        "edsaDatabaseName",
        "edsaDatabaseType",
        "edsaReplicationSupport",
        "edsaReplicationRole"
      ]
    },
    {
      "id": "HistoryDatabases",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Management History Databases,CN=Server Configuration,CN=Configuration",
        "filter": "(objectClass=edsMHReplicationPartner)"
      },
      "attributes": [
        "edsaSQLAlias",
        "edsaDatabaseName",
        "edsaDatabaseType",
        "edsaReplicationRole"
      ]
    },
    {
      "id": "ScheduledTasks",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Scheduled Tasks,CN=Server Configuration,CN=Configuration",
        "filter": "(objectClass=edsScheduledTask)"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "edsaLastRunTime",
        "edsvaNextRunTime",
        "edsaDisableSchedule"
      ]
    },
    {
      "id": "EmptyAccessTemplates",
      "dataSource": "ActiveRoles",
