      },
      "attributes": [
        "name",
        "distinguishedName",
        "edsaATEList"
      ]
    },
    {
      "id": "PolicyObjectsNoRules",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Policies,CN=Configuration",
        "filter": "(objectClass=edsPolicyObject)"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "edsaAPEListXML"
      ]
    },
    {
      "id": "UnlinkedAccessTemplates",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Access Templates,CN=Configuration",
        "filter": "(&(objectClass=edsAccessTemplate)(edsaIsPredefined=FALSE)(edsaSystemObject=FALSE))"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "objectGUID"
      ]
    },
    {
      "id": "DenyAccessTemplates",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Access Templates,CN=Configuration",
        "filter": "(objectClass=edsAccessTemplate)"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "objectGUID",
        "edsaATEList"
      ]
    },
    {
      "id": "UnlinkedPolicyObjects",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Policies,CN=Configuration",
        "filter": "(&(objectClass=edsPolicyObject)(!(name=Built-in*)))"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "objectGUID"
      ]
    },
    {
      "id": "OrphanAccessTemplateLinks",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=AT Links,CN=Configuration",
        "filter": "(objectClass=edsACE)"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "edsaAccessTemplateGUID",
        "edsaSecObjectGUID",
        "edsaTrusteeSID"
      ]
    },
    {
      "id": "DelegationLinks",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=AT Links,CN=Configuration",
        "filter": "(objectClass=edsACE)"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "edsaTrusteeSID",
        "edsaSecObjectGUID",
        "edsaAccessTemplateGUID",
        "edsaIsPredefined",
        "edsaSystemObject"
      ],
      "keyAttribute": "distinguishedName",
      "enrichments": [
        {
          "name": "trustee",
          "args": {
            "attribute": "edsaTrusteeSID"
          }
        },
        {
          "name": "rootScope",
          "args": {
            "attribute": "edsaSecObjectGUID"
          }
        }
      ]
    },
    {
      "id": "OrphanPolicyObjectLinks",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=AP Links,CN=Configuration",
        "filter": "(objectClass=edsPolicyObjectLink)"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "edsaAPOGUID",
        "edsaSecObjectGUID"
      ]
    },
    {
      "id": "DynamicGroupsWithBrokenRules",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Configuration",
        "filter": "(objectClass=edsDynamicGroup)"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "edsaDGConditionsList"
      ],
      "keyAttribute": "distinguishedName",
      "enrichments": [
        {
          "name": "unresolvedGuids",
          "args": {
            "attribute": "edsaDGConditionsList"
          }
        }
      ]
    },
    {
      "id": "ManagedUnitsWithBrokenRules",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Managed Units,CN=Configuration",
        "filter": "(objectClass=edsManagedUnit)"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "edsaMUConditionsList"
      ],
      "keyAttribute": "distinguishedName",
      "enrichments": [
        {
          "name": "unresolvedGuids",
          "args": {
            "attribute": "edsaMUConditionsList"
          }
        }
      ]
    },
    {
      "id": "ScriptModules",
      "dataSource": "ActiveRoles",
      "retrieval": {
        "base": "CN=Script Modules,CN=Configuration",
        "filter": "(objectClass=edsScriptModule)"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "edsaScriptLanguage",
        "edsaScriptType",
        "edsaSystemObject",
        "edsaIsPredefined"
      ]
    },
    {
      "id": "EntraTenants",
      "dataSource": "EntraId",
      "retrieval": {
        "base": "{DefaultAzureConfigurationDN}",
        "filter": "(objectClass=edsAzureTenantcontainer)",
        "scope": "one"
      },
      "attributes": [
        "name",
        "distinguishedName"
      ],
      "keyAttribute": "distinguishedName",
      "enrichments": [
        {
          "name": "descendantCount"
        }
      ]
    }
