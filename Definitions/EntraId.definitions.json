  "datasets": [
    {
      "id": "EntraObjects",
      "dataSource": "EntraId",
      "retrieval": {
        "base": "{DefaultAzureConfigurationDN}"
      },
      "attributes": [
        "name",
        "distinguishedName",
        "edsaAzureUserAccountEnabled",
        "manager",
        "edsaAzureUserPrincipalName",
        "edsvaOnPremisesSyncEnabled",
        "edsvaAPOLinksEffective",
        "visibility",
        "member",
        "edsaAzureGroupManagedBy"
      ],
      "segmentAttribute": "entraTenant",
      "keyAttribute": "distinguishedName"
    }
  ],
