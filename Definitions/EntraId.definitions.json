          },
          {
            "attribute": "entraTenant",
            "header": "Tenant"
          },
          {
            "attribute": "distinguishedName",
            "header": "Distinguished Name"
          },
          {
            "expression": "!in(edsaAzureUserAccountEnabled, 'false', '0')",
            "header": "Enabled"
          },
          {
            "expression": "!containsAny(edsvaAPOLinksEffective, $excludeLinkDns)",
            "header": "Managed"
          }
        ]
      },
      "fallbackText": "Enabled Users"
    },
