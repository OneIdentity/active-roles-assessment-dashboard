      "ExchangeSharedMailboxes": "(&(objectClass=user)(msExchRecipientTypeDetails=4))",
      "ExchangeRoomMailboxes": "(&(objectClass=user)(msExchRecipientTypeDetails=16))",
      "ExchangeEquipmentMailboxes": "(&(objectClass=user)(msExchRecipientTypeDetails=32))",
      "ExchangeMailUsers": "(&(objectClass=user)(msExchRecipientTypeDetails=128))",
      "ExchangeMailContacts": "(&(objectClass=contact)(msExchRecipientTypeDetails=64))",
      "ExchangeDistributionGroups": "(&(objectClass=group)(mailNickname=*)(msExchRecipientDisplayType=1))",
      "ExchangeMailEnabledSecurityGroups": "(&(objectClass=group)(mailNickname=*)(msExchRecipientDisplayType=1073741833))",
      "ExchangeDynamicDistributionGroups": "(objectClass=msExchDynamicDistributionList)",
      "ExchangeGroupsNoOwner": "(&(objectClass=group)(mailNickname=*)(!(managedBy=*)))",
      "ExchangeEmptyDistributionGroups": "(&(objectClass=group)(mailNickname=*)(msExchRecipientDisplayType=1)(!(member=*)))",
      "ExchangeMailboxNoManager": "(&(objectClass=user)(homeMDB=*)(!(manager=*)))",
      "ExchangeOrphanedMailboxes": "(&(objectClass=user)(homeMDB=*)(userAccountControl:1.2.840.113556.1.4.803:=2))",
      "ExchangeLitigationHoldDisabled": "(&(objectClass=user)(homeMDB=*)(|(!(edsva-MsExch-LitigationHoldEnabled=*))(edsva-MsExch-LitigationHoldEnabled=FALSE)))",
      "ExchangeFullAccessDelegates": "(&(objectClass=user)(homeMDB=*)(msExchDelegateListLink=*))",
