{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ActiveRolesDashboard.Services.ActiveRolesService": "Information"
    }
  },
  "AllowedHosts": "*",
  "PathBase": "",
  "ActiveRoles": {
    "WebInterfaceUrl": "",
    "RstsUrl": "",
    "ApiBaseUrl": "",
    "Resource": "ActiveRoles",
    "IgnoreSslErrors": false,
    "DefaultActiveDirectoryDN": "CN=Active Directory",
    "DefaultARConfigurationDN": "CN=Configuration",
    "DefaultFilters": {
      "NoGroupOwner": "(&(objectClass=group)(!(managedBy=*))(!(edsvaSecondaryOwners=*)))",
      "NoManagerUser": "(&(objectClass=user)(objectCategory=person)(!(manager=*)))",
      "NoManagerServiceAccount": "(&(objectClass=user)(objectCategory=person)(servicePrincipalName=*)(!(manager=*)))",
      "ServiceAccounts": "(&(objectClass=user)(objectCategory=person)(servicePrincipalName=*))",
      "GmsaServiceAccounts": "(objectClass=msDS-GroupManagedServiceAccount)",
      "SmsaServiceAccounts": "(objectClass=msDS-ManagedServiceAccount)",
      "UserAccountExpired": "(&(objectClass=user)(objectCategory=person)(edsvaAccountIsExpired=TRUE))",
      "UserAccountLockedOut": "(&(objectClass=user)(objectCategory=person)(lockoutTime>=1))",
      "EmptyGroups": "(&(objectClass=group)(!(member=*)))",
      "ActiveRolesAdmins": "(&(objectClass=group)(name=APP-ACTIVEROLES-ADMINS))",
      "ADUserAccounts": "(&(objectClass=user)(objectCategory=person))",
      "ADGroups": "(objectClass=group)",
      "ExchangeServers": "(&(objectClass=msExchExchangeServer)(!(objectClass=msExchExchangeTransportServer)))",
      "ExchangeMailboxDatabases": "(objectClass=msExchPrivateMDB)",
      "ExchangeMailboxServers": "(&(objectClass=msExchExchangeServer)(msExchCurrentServerRoles:1.2.840.113556.1.4.803:=2))",
      "ExchangeDAGs": "(objectClass=msExchMDBAvailabilityGroup)",
      "ExchangeAcceptedDomains": "(objectClass=msExchAcceptedDomain)",
      "ExchangeUserMailboxes": "(&(objectClass=user)(homeMDB=*)(msExchRecipientTypeDetails=1))",
      "ExchangeSharedMailboxes": "(&(objectClass=user)(msExchRecipientTypeDetails=4))",
      "ExchangeRoomMailboxes": "(&(objectClass=user)(msExchRecipientTypeDetails=16))",
      "ExchangeEquipmentMailboxes": "(&(objectClass=user)(msExchRecipientTypeDetails=32))",
      "ExchangeMailUsers": "(&(objectClass=user)(msExchRecipientTypeDetails=128))",
      "ExchangeMailContacts": "(&(objectClass=contact)(msExchRecipientTypeDetails=64))",
      "ExchangeDistributionGroups": "(&(objectClass=group)(mailNickname=*)(msExchRecipientDisplayType=1))",
      "ExchangeMailEnabledSecurityGroups": "(&(objectClass=group)(mailNickname=*)(msExchRecipientDisplayType=1073741833))",
      "ExchangeDynamicDistributionGroups": "(objectClass=msExchDynamicDistributionList)",
      "ExchangeGroupsNoOwner": "(&(objectClass=group)(mailNickname=*)(!(managedBy=*)))",
      "ExchangeEmptyDistributionGroups": "(&(objectClass=group)(mailNickname=*)(msExchRecipientDisplayType=1)(!(member=*)))",
      "ExchangeMailboxNoManager": "(&(objectClass=user)(homeMDB=*)(!(manager=*)))",
      "ExchangeOrphanedMailboxes": "(&(objectClass=user)(homeMDB=*)(userAccountControl:1.2.840.113556.1.4.803:=2))",
      "ExchangeLitigationHoldDisabled": "(&(objectClass=user)(homeMDB=*)(|(!(edsva-MsExch-LitigationHoldEnabled=*))(edsva-MsExch-LitigationHoldEnabled=FALSE)))"
    },
    "StaleAccountThresholdDays": 90,
    "Entra": {
      "MembershipFetchConcurrency": 8,
      "MembershipBatchSize": 40,
      "MembershipToastDelayMs": 500,
      "LargeGroupMemberThreshold": 100
    },
    "Licensing": {
      "DomainObjects": 150,
      "SaasObjects": 250,
      "PartitionObjects": 0,
      "AzureObjects": 0,
      "TotalObjects": 900
    },
    "DefaultADUserAccountAttributes": [
      "name",
      "distinguishedName",
      "edsaDomainNetbiosName",
      "manager",
      "edsvaSecondaryOwners",
      "accountExpires",
      "pwdLastSet",
      "lockoutTime",
      "userAccountControl",
      "employeeType",
      "employeeID",
      "lastLogonTimestamp",
      "adminCount",
      "edsvaDeprovisionStatus",
      "description",
      "servicePrincipalName"
    ],
    "CustomADUserAccountAttributes": [],
    "CustomNoGroupOwnerBaseDn": "",
    "CustomNoManagerUserBaseDn": "",
    "CustomNoManagerUserFilter": "",
    "CustomNoManagerServiceAccountBaseDn": "",
    "CustomNoManagerServiceAccountFilter": "",
    "CustomUserAccountExpiredBaseDn": "",
    "CustomUserAccountLockedOutBaseDn": "",
    "CustomEmptyGroupsBaseDn": "",
    "CustomActiveRolesAdminsBaseDn": "",
    "CustomActiveRolesAdminsFilter": "",
    "DefaultLanguage": "en",
    "ServiceAccount": {
      "Username": "",
      "ProtectedPassword": ""
    },
    "DataRefresh": {
      "DailyRefreshTime": "02:00",
      "LoadOnStartup": true
    }
  }
}