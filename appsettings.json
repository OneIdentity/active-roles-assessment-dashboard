{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ActiveRolesDashboard.Services.ActiveRolesService": "Information"
    }
  },
  "AllowedHosts": "*",
  "PathBase": "",
  "ActiveRoles": {
    "WebInterfaceUrl": "https://winemeaapp04/ARWebAdmin",
    "RstsUrl": "https://winemeaapp04:443/rsts/oauth2/token",
    "ApiBaseUrl": "https://winemeaapp04:5000/api/v1",
    "Resource": "ActiveRoles",
    "IgnoreSslErrors": false,
    "DefaultActiveDirectoryDN": "CN=Active Directory",
    "DefaultARConfigurationDN": "CN=Configuration",
    "DefaultNoGroupOwnerFilter": "(&(objectClass=group)(!(managedBy=*))(!(edsvaSecondaryOwners=*)))",
    "DefaultNoManagerUserFilter": "(&(objectClass=user)(objectCategory=person)(!(manager=*)))",
    "DefaultNoManagerServiceAccountFilter": "(&(objectClass=user)(objectCategory=person)(servicePrincipalName=*)(!(manager=*)))",
    "DefaultUserAccountExpiredFilter": "(&(objectClass=user)(objectCategory=person)(edsvaAccountIsExpired=TRUE))",
    "DefaultUserAccountLockedOutFilter": "(&(objectClass=user)(objectCategory=person)(lockoutTime>=1))",
    "DefaultEmptyGroupsFilter": "(&(objectClass=group)(!(member=*)))",
    "DefaultActiveRolesAdminsFilter": "(&(objectClass=group)(name=APP-ACTIVEROLES-ADMINS))",
    "DefaultADUserAccountsFilter": "(&(objectClass=user)(objectCategory=person))",
    "StaleAccountThresholdDays": 90,
    "EntraMembershipFetchConcurrency": 8,
    "EntraMembershipBatchSize": 40,
    "EntraMembershipToastDelayMs": 500,
    "EntraLargeGroupMemberThreshold": 100,
    "DefaultADUserAccountAttributes": [
      "name",
      "distinguishedName",
      "edsaDomainNetbiosName",
      "manager",
      "edsvaSecondaryOwners",
      "accountExpires",
      "pwdLastSet",
      "lockoutTime",
      "userAccountControl",
      "employeeType",
      "employeeID",
      "lastLogonTimestamp",
      "adminCount",
      "edsvaDeprovisionStatus",
      "description",
      "servicePrincipalName"
    ],
    "DefaultADGroupsFilter": "(objectClass=group)",
    "CustomADUserAccountAttributes": [],
    "CustomNoGroupOwnerBaseDn": "",
    "CustomNoManagerUserBaseDn": "",
    "CustomNoManagerUserFilter": "",
    "CustomNoManagerServiceAccountBaseDn": "",
    "CustomNoManagerServiceAccountFilter": "",
    "CustomUserAccountExpiredBaseDn": "",
    "CustomUserAccountLockedOutBaseDn": "",
    "CustomEmptyGroupsBaseDn": "",
    "CustomActiveRolesAdminsBaseDn": "",
    "CustomActiveRolesAdminsFilter": ""
  }
}