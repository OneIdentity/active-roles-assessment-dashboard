<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile for deploying the Active Roles Dashboard to winemeaapp04.

  Hosting model: IIS, out-of-process, framework-dependent (see web.config).
  REQUIREMENT: winemeaapp04 must have the ASP.NET Core 9 Hosting Bundle installed
  (https://dotnet.microsoft.com/download/dotnet/9.0 -> "Hosting Bundle").

  Usage (from the project directory):
	  dotnet publish ActiveRolesDashboard.csproj /p:PublishProfile=winemeaapp04

  This profile only produces the publish output locally (into publish\winemeaapp04).
  Use deploy\Publish-ToWinemeaapp04.ps1 to publish AND copy to the target while
  preserving the machine-specific appsettings.json and App_Data (Data Protection keys).
-->
<Project>
  <PropertyGroup>
	<WebPublishMethod>FileSystem</WebPublishMethod>
	<PublishProvider>FileSystem</PublishProvider>
	<LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
	<LastUsedPlatform>Any CPU</LastUsedPlatform>
	<SiteUrlToLaunchAfterPublish />
	<LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
	<ExcludeApp_Data>true</ExcludeApp_Data>
	<TargetFramework>net9.0</TargetFramework>
	<RuntimeIdentifier />
	<SelfContained>false</SelfContained>
	<Configuration>Release</Configuration>
	<PublishDir>publish\winemeaapp04\</PublishDir>
  </PropertyGroup>
</Project>
