@page
@model ActiveRolesDashboard.Pages.LoginModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = "Login";
    Layout = null;
}
@if (!string.IsNullOrEmpty(Model.RedirectUrl))
{
    <text><!DOCTYPE html><html><head><meta http-equiv="refresh" content="0;url=@(Model.RedirectUrl)" /><script>window.location.replace("@(Model.RedirectUrl)");</script></head><body>Redirecting to @Model.RedirectUrl...</body></html></text>
    return;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Localizer["PageTitle"]</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { background: #fff; border-radius: 16px; padding: 48px 40px; box-shadow: 0 20px 60px rgba(0,0,0,.3); width: 100%; max-width: 420px; }
        .login-card h1 { font-size: 1.5rem; color: #111827; margin-bottom: 6px; }
        .login-card p.sub { font-size: .88rem; color: #6b7280; margin-bottom: 28px; }
        .form-group { margin-bottom: 18px; }
        .form-group label { display: block; font-size: .82rem; font-weight: 600; color: #374151; margin-bottom: 6px; }
        .form-group input { width: 100%; padding: 12px 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: .9rem; transition: border-color .2s; }
        .form-group input:focus { outline: none; border-color: #1a1a2e; box-shadow: 0 0 0 3px rgba(26,26,46,.1); }
        .btn-login { width: 100%; padding: 13px; background: #1a1a2e; color: #fff; border: none; border-radius: 8px; font-size: .95rem; font-weight: 600; cursor: pointer; transition: background .2s; }
        .btn-login:hover { background: #16213e; }
        .error-msg { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 10px 14px; border-radius: 8px; font-size: .84rem; margin-bottom: 18px; }
        .logo { text-align: center; margin-bottom: 24px; }
        .logo img { height: 40px; width: auto; }
        .lang-switch { position: absolute; top: 16px; right: 16px; display: flex; align-items: center; gap: 6px; }
        .lang-switch img { height: 16px; width: 22px; object-fit: cover; border-radius: 2px; box-shadow: 0 0 0 1px rgba(0,0,0,.1); }
        .lang-switch select { border: 1px solid #d1d5db; border-radius: 6px; background: #fff; font-size: .78rem; color: #374151; padding: 4px 6px; cursor: pointer; }
        .lang-switch select:focus { outline: none; border-color: #1a1a2e; }
        .login-card { position: relative; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="lang-switch">
            <img id="langFlag" src="@(HttpContext.Request.PathBase)/@(Model.SelectedLanguage.FlagImage)" alt="@Model.SelectedLanguage.DisplayName" />
            <select id="langSelect" aria-label="Language" onchange="setLanguage(this)">
                @foreach (var lang in Model.Languages)
                {
                    <option value="@lang.Code" data-flag="@(HttpContext.Request.PathBase)/@(lang.FlagImage)" selected="@(lang.Code == Model.SelectedLanguage.Code)">@lang.DisplayName</option>
                }
            </select>
        </div>
        <div class="logo"><img src="@Url.Content("~/images/oneidentity-logo-v2.svg")" alt="One Identity" /></div>
        <h1>@Localizer["Heading"]</h1>
        <p class="sub">@Localizer["Subtitle"]</p>
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error-msg">@Model.ErrorMessage</div>
        }
        <form method="post" id="loginForm">
            <div class="form-group">
                <label for="username">@Localizer["Username"]</label>
                <input type="text" id="username" name="Username" placeholder="domain\username" required autofocus />
            </div>
            <div class="form-group">
                <label for="password">@Localizer["Password"]</label>
                <input type="password" id="password" name="Password" required />
            </div>
            <button type="submit" class="btn-login">@Localizer["SignIn"]</button>
        </form>
    </div>
    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-spinner">
            <div class="spinner"></div>
            <p id="loadingMessage">@Localizer["SigningIn"]</p>
        </div>
    </div>
<style>
    .loading-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(26,26,46,.9); display: none; align-items: center; justify-content: center; z-index: 2000; }
    .loading-overlay.active { display: flex; }
    .loading-spinner { text-align: center; }
    .loading-spinner p { margin-top: 16px; font-size: .9rem; font-weight: 600; color: #fff; }
    .spinner { width: 40px; height: 40px; margin: 0 auto; border: 4px solid rgba(255,255,255,.3); border-top-color: #fff; border-radius: 50%; animation: spin .8s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>
@await Html.PartialAsync("_AppBaseScript")
<script>
    var loginI18n = {
        loadingData: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["LoadingData"].Value)),
        buildingCache: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["BuildingCache"].Value)),
        filteringData: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["FilteringData"].Value))
    };
    function setLanguage(select) {
        var opt = select.options[select.selectedIndex];
        var flag = opt.getAttribute('data-flag');
        if (flag) document.getElementById('langFlag').src = flag;
        var code = select.value;
        // Standard ASP.NET Core culture cookie format: c=<culture>|uic=<ui-culture>
        var value = 'c=' + code + '|uic=' + code;
        document.cookie = '.AspNetCore.Culture=' + encodeURIComponent(value) +
            ';path=' + (appBase || '/') + ';max-age=31536000;samesite=lax';
        window.location.reload();
    }
    document.getElementById('loginForm').addEventListener('submit', function(e) {
        e.preventDefault();
        var overlay = document.getElementById('loadingOverlay');
        var msg = document.getElementById('loadingMessage');
        overlay.classList.add('active');
        var form = this;

        // Poll the shared cache status until it is Ready, keeping the user on the login overlay
        // ("Building cache…") so they never land on an empty/partial dashboard. Once ready, show
        // "Filtering data…" while the per-user projection is prepared, then redirect.
        function waitForCacheThenRedirect(redirectUrl) {
            var base = (appBase || '');
            function poll() {
                fetch(base + '/cache/status', { headers: { 'Accept': 'application/json' } })
                    .then(function(r) { return r.json(); })
                    .then(function(status) {
                        if (status && status.ready) {
                            msg.textContent = loginI18n.filteringData;
                            window.location.href = redirectUrl;
                        } else {
                            msg.textContent = loginI18n.buildingCache;
                            setTimeout(poll, 1500);
                        }
                    })
                    .catch(function() {
                        // Status endpoint unreachable: don't trap the user, just proceed.
                        window.location.href = redirectUrl;
                    });
            }
            poll();
        }

        fetch(form.action || window.location.href, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'Accept': 'application/json' }
        }).then(function(response) {
            var ct = response.headers.get('content-type') || '';
            if (response.ok && ct.indexOf('application/json') !== -1) {
                return response.json().then(function(data) {
                    // Message is localized server-side in the authenticated user's culture.
                    if (data && data.loadingMessage) msg.textContent = data.loadingMessage;
                    var redirectUrl = (data && data.redirectUrl) ? data.redirectUrl : (appBase + '/');
                    waitForCacheThenRedirect(redirectUrl);
                });
            } else {
                // Validation/authentication failure returns the re-rendered login page (HTML).
                return response.text().then(function(html) {
                    overlay.classList.remove('active');
                    document.open();
                    document.write(html);
                    document.close();
                });
            }
        }).catch(function() {
            overlay.classList.remove('active');
            form.submit();
        });
    });
</script>
</body>
</html>
