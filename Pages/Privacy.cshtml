@page
@model PrivacyModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Title"].Value;
    Layout = null;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@Url.Content("~/")" />
    <title>Active Roles Dashboard - @Localizer["Title"]</title>
    <link rel="stylesheet" href="css/iris-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="css/iris-auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="css/iris-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="css/iris-snapshots.css" asp-append-version="true" />
    <style>
        .iris-privacy .iris-title-row { display: flex; align-items: center; justify-content: space-between; gap: var(--oi-spacing-m); flex-wrap: wrap; }
        .iris-privacy .privacy-back { display: inline-flex; align-items: center; text-decoration: none; }
        .iris-privacy .privacy-back:hover { background: var(--oi-background-color-secondary); }
        .iris-privacy .snap-card { max-width: 820px; }
        .iris-privacy .snap-card p { font-size: var(--oi-font-size-s); color: var(--oi-content-color-secondary); line-height: 1.6; margin: 0; }
    </style>
</head>
<body class="iris-shell iris-privacy">
<div class="page iris-shell-page">
    @{
        ViewData["IrisActive"] = "privacy";
        ViewData["IrisCrumb"] = Localizer["Title"].Value;
    }
    <partial name="_IrisShell" />
    <main class="iris-shell-main">
    <div class="iris-title-row">
        <h1>@Localizer["Title"]</h1>
        <a class="snap-btn privacy-back" href="@(HttpContext.Request.PathBase)/app/?restore=1">@Localizer["BackToDashboard"]</a>
    </div>

    <section class="snap-card">
        <h2>@Localizer["Title"]</h2>
        <p>@Localizer["Body"]</p>
    </section>

    <section class="snap-card">
        <h2>@Localizer["AnalyticsTitle"]</h2>
        <p>@Localizer["AnalyticsBody"]</p>
    </section>
    </main>
</div>
</body>
</html>
