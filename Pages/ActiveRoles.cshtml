@page
@model ActiveRolesDashboard.Pages.ActiveRolesModel
@{
    ViewData["Title"] = "Active Roles";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <base href="@Url.Content("~/")" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Active Roles Dashboard - Active Roles</title>
    <link rel="stylesheet" href="css/dashboard.css" asp-append-version="true" />
</head>
<body>
<div class="loading-overlay active" id="loadingOverlay">
    <div class="loading-spinner">
        <div class="spinner"></div>
        <p>Loading Dashboard Data...</p>
    </div>
</div>
<div class="page">
    <div class="sticky-head">
    <header class="rpt-header">
        <div class="hdr-left">
            <span class="hdr-logo"><img src="images/oneidentity-logo-v2.svg" alt="One Identity" /></span>
            <div>
                <h1>Active Roles</h1>
                <p class="hdr-sub">Active Roles configuration KPIs</p>
            </div>
        </div>
        <div class="hdr-right">
            @{ ViewData["RefreshUrl"] = "/ActiveRoles"; ViewData["ShowHome"] = true; ViewData["DashboardKey"] = "ActiveRoles"; }
            @await Html.PartialAsync("_DashboardToolbar")
        </div>
    </header>

    <a href="@(HttpContext.Request.PathBase)/?cached=true" class="back-link">&larr; Back to Dashboard</a>
    </div>

    @if (Model.IsActiveRolesAdmin && Model.KpiSettings.ARConfigurationEnabled)
    {
    <div class="kpi-category">
        <h2 class="kpi-category-title"><span>@CategoryInfo.ARConfiguration.DisplayName</span><button type="button" class="btn-collapse" onclick="toggleCategory(this)" title="Collapse">&#9650;</button></h2>
        <div class="kpi-grid">
            @foreach (var kpi in KpiInfo.ForCategory(CategoryInfo.ARConfiguration))
            {
                if (!Model.KpiSettings.IsKpiEnabled(CategoryInfo.ARConfiguration.Key, kpi.Key)) { continue; }
                var result = Model.Summary.GetKpiResult(kpi.Key);
            <div class="kpi @kpi.CssColor" data-section="@kpi.SectionId">
                <div class="lbl">@kpi.Label</div>
                <div class="val">@(result.Error ?? result.Count.ToString())</div>
            </div>
            }
        </div>
        @await Html.PartialAsync("_CategoryCharts", (CategoryInfo.ARConfiguration, Model.Summary, Model.KpiSettings))
    </div>
    }

    <hr class="kpi-separator" />

    <!-- Drill-down panels -->
    <div class="panel-grid">
        @if (Model.IsActiveRolesAdmin && Model.KpiSettings.IsKpiEnabled("Configuration", "ActiveRolesAdmins"))
        {
        <div class="panel" id="panel-aradmins">
            <h2><span class="sec-icon">R</span> Active Roles Admins
                @if (Model.Summary.ActiveRolesAdmins.HasIndirectMembers && !string.IsNullOrEmpty(Model.Summary.ActiveRolesAdmins.GroupDn))
                {
                    <a href="GroupTree?Group=@(Uri.EscapeDataString(Model.Summary.ActiveRolesAdmins.GroupDn!))&return=panel-aradmins&returnPage=ActiveRoles" title="View nested membership" class="btn-manage sec-tree-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </a>
                }
                else
                {
                    <span class="btn-manage disabled sec-tree-btn" title="No indirect (nested) members">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </span>
                }
            </h2>
            <div class="panel-content">
                @if (Model.Summary.ActiveRolesAdmins.Error != null)
                {
                    <p class="muted">@Model.Summary.ActiveRolesAdmins.Error</p>
                }
                else
                {
                    <table>
                        <thead><tr><th>Name</th><th>Distinguished Name</th><th>Membership</th><th style="width:40px;"></th></tr></thead>
                        <tbody>
                        @foreach (var m in Model.Summary.ActiveRolesAdmins.Items)
                        {
                            <tr>
                                <td>@m.Name</td>
                                <td class="dn-cell">@m.Dn</td>
                                <td><span class="type-pill">@m.MembershipType</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(m.Dn))
                                    {
                                        @if (!string.IsNullOrEmpty(Model.WebInterfaceUrl))
                                        {
                                            <a href="javascript:void(0)" onclick="openWebInterface('@(Model.WebInterfaceUrl.TrimEnd('/'))/redirect.ashx?dn=@(Uri.EscapeDataString(m.Dn))')" title="Open in Web Interface" class="btn-manage">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="btn-manage disabled" title="Configure Web Interface URL in Settings">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                            </span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Summary.ActiveRolesAdmins.Items.Any())
                        {
                            <tr><td colspan="4" class="empty-row">No members found</td></tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
        }

        @if (Model.IsActiveRolesAdmin && Model.KpiSettings.IsKpiEnabled("Configuration", "Domains"))
