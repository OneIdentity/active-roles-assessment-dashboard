                                <td>@d.Name</td>
                                <td>@d.DnsName</td>
                                <td>@d.Dn</td>
                                <td>@d.UseOverride</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(d.Dn))
                                    {
                                        @if (!string.IsNullOrEmpty(Model.WebInterfaceUrl))
