<div class="panel" id="panel-nokerberospreauth">
    <h2><span class="sec-icon">K</span> Do Not Require Kerberos Preauthentication</h2>
    <div class="panel-content">
        @if (Model.Summary.NoKerberosPreauth.Error != null)
        {
            <p class="muted">@Model.Summary.NoKerberosPreauth.Error</p>
        }
        else
        {
            <table>
                <thead><tr><th>Name</th><th>Distinguished Name</th><th style="width:40px;"></th></tr></thead>
                <tbody>
                @foreach (var l in Model.Summary.NoKerberosPreauth.Items)
                {
                    <tr>
                        <td>@l.Name</td>
                        <td class="dn-cell">@l.Dn</td>
                        <td>
                            @if (!string.IsNullOrEmpty(l.Dn) && !string.IsNullOrEmpty(Model.WebInterfaceUrl))
                            {
                                <a href="javascript:void(0)" onclick="openWebInterface('@(Model.WebInterfaceUrl.TrimEnd('/'))/redirect.ashx?dn=@(Uri.EscapeDataString(l.Dn))')" title="Open in Web Interface" class="btn-manage">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(l.Dn))
                            {
                                <span class="btn-manage disabled" title="Configure Web Interface URL in Settings">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                </span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Summary.NoKerberosPreauth.Items.Any())
                {
                    <tr><td colspan="3" class="empty-row">No accounts without Kerberos preauthentication found</td></tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
}

