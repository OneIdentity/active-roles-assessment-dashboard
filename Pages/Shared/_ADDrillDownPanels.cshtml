@model ActiveRolesDashboard.Pages.DashboardPageModel

@if (Model.KpiSettings.IsKpiEnabled("ADGroupsCategory", "NoGroupOwner") || Model.KpiSettings.IsKpiEnabled("ADGovernance", "NoGroupOwner"))
{
<div class="panel" id="panel-nogroupowner">
    <h2><span class="sec-icon">N</span> No Group Owner</h2>
    <div class="panel-content">
        @if (Model.Summary.NoGroupOwner.Error != null)
        {
            <p class="muted">@Model.Summary.NoGroupOwner.Error</p>
        }
        else
        {
            <table>
                <thead><tr><th>Name</th><th>Distinguished Name</th><th style="width:72px;"></th></tr></thead>
                <tbody>
                @foreach (var g in Model.Summary.NoGroupOwner.Items)
                {
                    <tr>
                        <td>@g.Name</td>
                        <td class="dn-cell">@g.Dn</td>
                        <td>
                            @if (!string.IsNullOrEmpty(g.Dn))
                            {
                                <a href="GroupTree?Group=@(Uri.EscapeDataString(g.Dn))&return=panel-nogroupowner" title="View nested membership" class="btn-manage">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(g.Dn) && !string.IsNullOrEmpty(Model.WebInterfaceUrl))
                            {
                                <a href="javascript:void(0)" onclick="openWebInterface('@(Model.WebInterfaceUrl.TrimEnd('/'))/redirect.ashx?dn=@(Uri.EscapeDataString(g.Dn))')" title="Open in Web Interface" class="btn-manage">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(g.Dn))
                            {
                                <span class="btn-manage disabled" title="Configure Web Interface URL in Settings">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                </span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Summary.NoGroupOwner.Items.Any())
                {
                    <tr><td colspan="3" class="empty-row">No groups without an owner found</td></tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
}

