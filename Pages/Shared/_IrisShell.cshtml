@*
    IRIS application shell for Razor pages: mirrors the React dashboard sidebar (ClientApp/src/dashboard/Sidebar.tsx)
    and app bar so Razor pages share the same navigation. Pages render their content inside RenderBody-style
    markup after this partial and close it with </main></div></div> (see Snapshots.cshtml).
    ViewData:
      - "IrisActive": key of the active nav item (dashboard, assessment, exposure, snapshots, settings).
      - "IrisCrumb":  current page name shown in the breadcrumb.
*@
@using ActiveRolesDashboard.Pages
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    var page = ViewContext.ViewData.Model as DashboardPageModel;
    // Pages that are not DashboardPageModels (e.g. Settings) still expose their permission set.
    var perms = page?.DashboardPermissions
        ?? (ViewContext.ViewData.Model as SettingsModel)?.Permissions
        ?? (ViewContext.ViewData.Model as PrivacyModel)?.Permissions;
    bool Has(ActiveRolesDashboard.Models.DashboardPermission p) => perms?.Contains(p) == true;
    var active = ViewData["IrisActive"] as string ?? "";
    var crumb = ViewData["IrisCrumb"] as string ?? "";
    var appBase = Context.Request.PathBase.Value ?? "";
    string Current(string key) => key == active ? "page" : "false";
    var userName = User.Identity?.Name ?? "";
    var accountParts = userName.Split('\\')[^1].Split('@')[0]
        .Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
    var initials = string.Concat(accountParts.Take(2).Select(p => p[0])).ToUpperInvariant();
    var roleKey = string.Equals(Context.Session.GetString("IsActiveRolesAdmin"), "True", StringComparison.OrdinalIgnoreCase)
        ? "ActiveRolesAdmin"
        : Context.Session.GetString("DashboardRole");
    var roleLabel = string.IsNullOrEmpty(roleKey) ? null : Localizer["Role_" + roleKey];
    var userTooltip = roleLabel is { IsResourceNotFound: false } ? $"{userName}\n({roleLabel.Value})" : userName;
}
<aside class="sidebar" aria-label="@Localizer["MainNavigation"]">
    <div class="sidebar-header">
        <span class="sidebar-logo"><img src="@(appBase)/images/iris/figma-active-roles.svg" alt="" /></span>
        <span class="sidebar-title">@Localizer["ActiveRoles"]</span>
    </div>
    <nav class="sidebar-nav-group">
        <a href="@(appBase)/app/?restore=1" class="sidebar-nav-item" aria-current="@Current("dashboard")">
            <span class="sidebar-nav-asset sidebar-nav-asset-dashboard" aria-hidden="true"></span>
            <span>@Localizer["Dashboard"]</span>
        </a>
        @if (Has(ActiveRolesDashboard.Models.DashboardPermission.ViewAssessments))
        {
            <a href="@(appBase)/Assessments" class="sidebar-nav-item" aria-current="@Current("assessment")">
                <span class="sidebar-nav-asset sidebar-nav-asset-assessment" aria-hidden="true"></span>
                <span>@Localizer["Assessment"]</span>
            </a>
        }
        @if (Has(ActiveRolesDashboard.Models.DashboardPermission.ViewExposureReport))
        {
            <a href="@(appBase)/AttackExposure" class="sidebar-nav-item" aria-current="@Current("exposure")">
                <span class="sidebar-nav-asset sidebar-nav-asset-exposure" aria-hidden="true"></span>
                <span>@Localizer["AttackExposure"]</span>
            </a>
        }
        @if (Has(ActiveRolesDashboard.Models.DashboardPermission.ViewSnapshots))
        {
            <a href="@(appBase)/Snapshots" class="sidebar-nav-item" aria-current="@Current("snapshots")">
                <span class="sidebar-nav-asset sidebar-nav-asset-snapshots" aria-hidden="true"></span>
                <span>@Localizer["Snapshots"]</span>
            </a>
        }
    </nav>
    <div class="sidebar-nav-group">
        <div class="sidebar-nav-group-header">
            <span>@Localizer["Other"]</span>
        </div>
        @if (perms != null && ActiveRolesDashboard.Models.RolePermissionRegistry.CanAccessSettings(perms))
        {
            <a href="@(appBase)/Settings" class="sidebar-nav-item" aria-current="@Current("settings")">
                <span class="sidebar-nav-asset sidebar-nav-asset-settings" aria-hidden="true"></span>
                <span>@Localizer["Settings"]</span>
            </a>
        }
        @* Help page exists at /Help but is hidden from navigation until its content is finalized. *@
        <a href="@(appBase)/Help" class="sidebar-nav-item" aria-current="@Current("help")" hidden>
            <span class="sidebar-nav-asset sidebar-nav-asset-help" aria-hidden="true"></span>
            <span>@Localizer["HelpWith"]</span>
        </a>
        <a href="@(appBase)/Privacy" class="sidebar-nav-item" aria-current="@Current("privacy")">
            <span class="sidebar-nav-asset sidebar-nav-asset-privacy" aria-hidden="true"></span>
            <span>@Localizer["Privacy"]</span>
        </a>
        <a href="@(appBase)/Logout" class="sidebar-nav-item">
            <span class="sidebar-nav-asset sidebar-nav-asset-signout" aria-hidden="true"></span>
            <span>@Localizer["SignOut"]</span>
        </a>
    </div>
</aside>
<header class="iris-app-bar">
    <button class="iris-sidebar-toggle" type="button" id="irisSidebarToggle" aria-expanded="true"
            aria-label="@Localizer["CollapseNavigation"]"
            data-collapse="@Localizer["CollapseNavigation"]" data-expand="@Localizer["ExpandNavigation"]">
        <svg viewBox="0 0 18 14" width="18" height="14" aria-hidden="true">
            <path d="M16 13V14H2V13H16ZM17 12V2C17 1.44771 16.5523 1 16 1H2C1.44772 1 1 1.44772 1 2V12C1 12.5523 1.44771 13 2 13V14C0.89543 14 0 13.1046 0 12V2C0 0.89543 0.89543 0 2 0H16C17.1046 0 18 0.89543 18 2V12C18 13.1046 17.1046 14 16 14V13C16.5523 13 17 12.5523 17 12Z" fill="currentColor" />
            <rect class="iris-sidebar-toggle-pane" x="2" y="2" width="8" height="10" rx="1" fill="currentColor" />
        </svg>
    </button>
    <nav class="iris-breadcrumb" aria-label="@Localizer["Breadcrumb"]">
        <span>@Localizer["ActiveRoles"]</span><span aria-hidden="true">/</span><span aria-current="page">@crumb</span>
    </nav>
    <div class="iris-app-bar-right">
        <span id="membership-indicator" class="membership-indicator" hidden style="display:none" aria-live="polite">
            <svg class="membership-indicator-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            <span class="membership-indicator-badge" id="membership-indicator-badge">0</span>
        </span>
        @if (!string.IsNullOrEmpty(userName))
        {
            <span class="iris-avatar iris-avatar-default" role="img" aria-label="@userTooltip" title="@userTooltip">@initials</span>
        }
    </div>
</header>
<script>
    (function () {
        var btn = document.getElementById('irisSidebarToggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
            var collapsed = document.body.classList.toggle('iris-sidebar-collapsed');
            btn.setAttribute('aria-expanded', String(!collapsed));
            btn.setAttribute('aria-label', btn.getAttribute(collapsed ? 'data-expand' : 'data-collapse'));
        });
    })();
</script>
