@*
    Standalone page header (rpt-header) used by the Setup wizard.
    Parameters (via ViewData):
      - "HeaderKey": resource suffix for the localized Title_/Sub_ strings.
      - "HeaderTitle"/"HeaderSubtitle": explicit text when HeaderKey is not set.
      - "HeaderLogo": "oneidentity" (default) renders the One Identity logo image;
                      "ar" renders the "AR" text badge.
*@
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    var headerKey = ViewData["HeaderKey"] as string;
    var headerTitle = headerKey != null
        ? Localizer[$"Title_{headerKey}"].Value
        : ViewData["HeaderTitle"] as string ?? "Active Roles Dashboard";
    var headerSubtitle = headerKey != null
        ? Localizer[$"Sub_{headerKey}"].Value
        : ViewData["HeaderSubtitle"] as string;
    var headerLogo = ViewData["HeaderLogo"] as string ?? "oneidentity";
}
<header class="rpt-header">
    <div class="hdr-left">
        <span class="hdr-logo">
            @if (headerLogo == "ar")
            {
                @:AR
            }
            else
            {
                <img src="images/oneidentity-logo-v2.svg" alt="One Identity" />
            }
        </span>
        <div>
            <h1>@headerTitle</h1>
            @if (!string.IsNullOrEmpty(headerSubtitle))
            {
                <p class="hdr-sub">@headerSubtitle</p>
            }
        </div>
    </div>
</header>
