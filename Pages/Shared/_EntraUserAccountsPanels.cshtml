@model ActiveRolesDashboard.Pages.DashboardPageModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    string WebInterfaceUrl = Model.WebInterfaceUrl;
    var entra = Model.Summary.EntraTotals;
    var enabledUsers = entra.EntraUsers(enabled: true);
    var disabledUsers = entra.EntraUsers(enabled: false);
    var noManagerUsers = entra.EntraUsers(noManager: true);
    var guestUsers = entra.GuestUsers();
    var internalUsers = entra.EntraUsersByOrigin(external: false);
    var externalUsers = entra.EntraUsersByOrigin(external: true);
}
@functions {
    // Renders the shared "Open in Web Interface" action cell for an Entra user DN.
    Microsoft.AspNetCore.Html.IHtmlContent WebLink(string dn, string webUrl)
    {
        var svg = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg>";
        if (!string.IsNullOrEmpty(dn) && !string.IsNullOrEmpty(webUrl))
        {
            var href = $"{webUrl.TrimEnd('/')}/redirect.ashx?dn={Uri.EscapeDataString(dn)}";
            return new Microsoft.AspNetCore.Html.HtmlString(
                $"<a href=\"javascript:void(0)\" onclick=\"openWebInterface('{href}')\" title=\"{Localizer["Tip_OpenInWebInterface"].Value}\" class=\"btn-manage\">{svg}</a>");
        }
        if (!string.IsNullOrEmpty(dn))
        {
            return new Microsoft.AspNetCore.Html.HtmlString(
                $"<span class=\"btn-manage disabled\" title=\"{Localizer["Tip_ConfigureWebUrl"].Value}\">{svg}</span>");
        }
        return Microsoft.AspNetCore.Html.HtmlString.Empty;
    }
}

@if (Model.KpiSettings.IsKpiEnabled("EntraUserAccounts", "EntraEnabledUsers"))
{
<div class="panel" id="panel-entraenabledusers">
    <h2><span class="sec-icon">E</span> @Localizer["H_EnabledUsers"]</h2>
    <div class="panel-content">
        @if (enabledUsers.Error != null) { <p class="muted">@enabledUsers.Error</p> } else {
        <table><thead><tr><th>@Localizer["Col_Name"]</th><th>@Localizer["Col_Tenant"]</th><th>@Localizer["Col_Dn"]</th><th>@Localizer["Col_Enabled"]</th><th style="width:40px;"></th></tr></thead><tbody>
        @foreach (var u in enabledUsers.Items) { <tr><td>@u.Name</td><td>@u.Tenant</td><td class="dn-cell">@u.Dn</td><td>@u.Enabled</td><td>@WebLink(u.Dn, WebInterfaceUrl)</td></tr> }
        @if (!enabledUsers.Items.Any()) { <tr><td colspan="5" class="empty-row">@Localizer["E_EnabledUsers"]</td></tr> }
        </tbody></table> }
    </div>
</div>
}

