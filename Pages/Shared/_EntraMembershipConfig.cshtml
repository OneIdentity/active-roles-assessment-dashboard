@model ActiveRolesDashboard.Pages.DashboardPageModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    // Config for the client-side lazy membership loader (dashboard.js) and the global header
    // progress badge. Emitted on every dashboard page that pre-warms Entra totals (main
    // dashboard and Entra ID dashboard) so the badge/toast appear regardless of which panels
    // are rendered. The loader skips fetching when membership is already loaded.
    var entra = Model.Summary.EntraTotals;
    var membershipLoaded = entra.MembershipLoaded;

    // Total number of Entra group objects whose membership must be lazily loaded. Mirrors the
    // server's group-type classification (Security, Microsoft 365, Distribution, Dynamic Distribution).
    var totalGroupsToLoad =
        entra.EntraObjectsOf(EntraObjectType.DistributionGroup).Items.Count +
        entra.EntraObjectsOf(EntraObjectType.DynamicDistributionGroup).Items.Count +
        entra.EntraObjectsOf(EntraObjectType.Microsoft365Group).Items.Count +
        entra.EntraObjectsOf(EntraObjectType.SecurityGroup).Items.Count;

    // How many groups already have membership loaded (persisted in session). Lets the client
    // resume batched loading after page navigation instead of restarting from zero.
    var membershipAlreadyLoaded = Math.Min(totalGroupsToLoad, Math.Max(0, entra.MembershipLoadedCount));
}
@if (Model.Summary.EntraVisible)
{
<div id="entra-membership-config"
     data-endpoint="@Url.Page(null, "EntraMembership")"
     data-batch-endpoint="@Url.Page(null, "EntraMembershipBatch")"
     data-web-url="@Model.WebInterfaceUrl"
     data-loaded="@(membershipLoaded ? "true" : "false")"
     data-total-groups="@totalGroupsToLoad"
     data-loaded-count="@membershipAlreadyLoaded"
     data-batch-size="@Model.MembershipBatchSize"
     data-toast-delay="@Model.MembershipToastDelayMs"
     data-i18n-empty-emptygroups="@Localizer["Empty_EmptyGroups"]"
     data-i18n-empty-nogroupowner="@Localizer["Empty_NoGroupOwner"]"
     data-i18n-empty-guestcontaining="@Localizer["Empty_GuestContaining"]"
     data-i18n-empty-singleowner="@Localizer["Empty_SingleOwner"]"
     data-i18n-empty-largegroups="@Localizer["Empty_LargeGroups"]"
     data-i18n-failed-membership="@Localizer["FailedToLoadMembership"]"
     data-i18n-toast-loaded="@Localizer["Toast_MembershipLoaded"]"
     data-i18n-toast-failed="@Localizer["Toast_MembershipFailed"]"
     data-i18n-toast-loading="@Localizer["Toast_MembershipLoading"]"
     data-i18n-tip-openweb="@Localizer["Tip_OpenWebInterface"]"
     data-i18n-tip-configureweb="@Localizer["Tip_ConfigureWebUrl"]"
     hidden></div>
}
