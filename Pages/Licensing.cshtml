@if (Model.Summary.ManagedObjects.DataPoints.Any())
{
<script>
(function() {
    var canvas = document.getElementById('managedObjectsChart');
    if (!canvas) return;

    var dataPoints = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Summary.ManagedObjects.DataPoints.Select(dp => new {
            runTime = dp.RunTime.ToString("yyyy-MM-dd HH:mm"),
            items = dp.Items.Select(i => new {
                displayName = i.DisplayName,
                category = i.Category,
                count = i.Count,
                cloudOnly = i.CloudOnlyCount,
                hybrid = i.HybridCount,
                guest = i.GuestCount
            })
        })
    ));

    var labels = dataPoints.map(function(dp) { return dp.runTime; });

    // Each "series" is one underlying count. Domains contribute a single Total series;
    // Entra tenants expand into Cloud-Only / Hybrid / Guest series. SAAS is excluded upstream.
    // Series belonging to the same source (domain/tenant) share a base colour and are
    // differentiated by shades (lightness steps) of that colour.
    var sources = [];      // ordered list of source keys (category:displayName)
    var seriesList = [];   // { name, sourceKey, getter }
    dataPoints.forEach(function(dp) {
        dp.items.forEach(function(item) {
            var sourceKey = item.category + ': ' + item.displayName;
            if (sources.indexOf(sourceKey) === -1) {
                sources.push(sourceKey);
                if (item.category === 'Azure') {
                    seriesList.push({ name: item.displayName + ' \u2014 @Html.Raw(Localizer["Sub_CloudOnly"].Value)', sourceKey: sourceKey, field: 'cloudOnly' });
                    seriesList.push({ name: item.displayName + ' \u2014 @Html.Raw(Localizer["Sub_Hybrid"].Value)', sourceKey: sourceKey, field: 'hybrid' });
                    seriesList.push({ name: item.displayName + ' \u2014 @Html.Raw(Localizer["Sub_Guest"].Value)', sourceKey: sourceKey, field: 'guest' });
                } else {
                    seriesList.push({ name: item.displayName, sourceKey: sourceKey, field: 'count' });
                }
            }
        });
    });

    var baseColors = ['#2563eb','#16a34a','#d97706','#dc2626','#7c3aed','#0d9488','#db2777','#475569','#ea580c','#4f46e5'];
    function shade(hex, lightenPct) {
        var r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
        r = Math.round(r + (255 - r) * lightenPct);
        g = Math.round(g + (255 - g) * lightenPct);
        b = Math.round(b + (255 - b) * lightenPct);
        return 'rgb(' + r + ',' + g + ',' + b + ')';
    }

    // Assign a base colour per source, then a lightness step per series within that source.
    var perSourceIndex = {};
    var datasets = seriesList.map(function(s) {
        var srcIdx = sources.indexOf(s.sourceKey);
        var base = baseColors[srcIdx % baseColors.length];
        var within = (perSourceIndex[s.sourceKey] = (perSourceIndex[s.sourceKey] || 0)) ;
        perSourceIndex[s.sourceKey] = within + 1;
        var color = shade(base, within * 0.28);
        var data = dataPoints.map(function(dp) {
            var found = dp.items.find(function(item) { return (item.category + ': ' + item.displayName) === s.sourceKey; });
            return found ? found[s.field] : 0;
        });
        return { label: s.name, data: data, borderColor: color, backgroundColor: color, tension: 0.3, fill: false, pointRadius: 3 };
    });

    new Chart(canvas, {
        type: 'line',
        data: { labels: labels, datasets: datasets },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } },
            scales: {
                x: { title: { display: true, text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Chart_Time"].Value)) }, ticks: { maxRotation: 45, font: { size: 10 } } },
                y: { title: { display: true, text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Chart_ObjectCount"].Value)) }, beginAtZero: true }
            }
        }
    });
})();
</script>
}
@if (licHasData)
{
    <script>
(function() {
    var canvas = document.getElementById('licensingThresholdsChart');
    if (!canvas || typeof Chart === 'undefined') { return; }
    var cats = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(licCategories));
    var labels = cats.map(function(c) { return c.label; });
    var breachColor = '#dc2626';
    var entitlementColor = '#111827';

    // Per-category colours matching the Managed Objects chart palette;
    // Grand Total gets its own distinct colour.
    var categoryColors = {
        'Domain': '#2563eb',
        'Partition': '#16a34a',
        'Azure': '#d97706',
        'Total': '#475569'
    };
    function colorFor(key) { return categoryColors[key] || '#2563eb'; }

    var barData = cats.map(function(c) { return c.total; });
    var barColors = cats.map(function(c) {
        return (c.threshold > 0 && c.total > c.threshold) ? breachColor : colorFor(c.key);
    });

    // Threshold overlay: an independent per-category marker (no connecting line),
    // shown only where an entitlement is configured, sitting above each bar.
    var thresholdData = cats.map(function(c) { return c.threshold > 0 ? c.threshold : null; });

    // Draws each entitlement marker as a horizontal line spanning the exact pixel
    // width of the bar beneath it, so the marker width matches the data point rather
    // than using a fixed point size that looks too narrow.
    var thresholdMarkerPlugin = {
        id: 'thresholdMarker',
        afterDatasetsDraw: function(chart) {
            var barMeta = chart.getDatasetMeta(0);
            var lineMeta = chart.getDatasetMeta(1);
            if (!barMeta || !lineMeta || lineMeta.hidden) return;
            var ctx = chart.ctx;
            ctx.save();
            ctx.strokeStyle = entitlementColor;
            ctx.lineWidth = 3;
            lineMeta.data.forEach(function(point, i) {
                if (thresholdData[i] === null || thresholdData[i] === undefined) return;
                var bar = barMeta.data[i];
                if (!bar) return;
                var halfWidth = (bar.width || 0) / 2;
                var y = point.y;
                ctx.beginPath();
                ctx.moveTo(bar.x - halfWidth, y);
                ctx.lineTo(bar.x + halfWidth, y);
                ctx.stroke();
            });
            ctx.restore();
        }
    };

    new Chart(canvas, {
        type: 'bar',
        plugins: [thresholdMarkerPlugin],
        data: {
            labels: labels,
            datasets: [
                {
                    type: 'bar',
                    label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Chart_Actual"].Value)),
                    data: barData,
                    backgroundColor: barColors,
                    borderColor: barColors,
                    borderWidth: 1,
                    order: 2
                },
                {
                    type: 'line',
                    label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Chart_Entitlement"].Value)),
                    data: thresholdData,
                    borderColor: entitlementColor,
                    backgroundColor: entitlementColor,
                    pointRadius: 0,
                    pointHoverRadius: 11,
                    pointStyle: 'line',
                    pointBorderWidth: 3,
                    showLine: false,
                    spanGaps: false,
                    order: 1
                }
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        boxWidth: 12, font: { size: 11 }, usePointStyle: true,
                        generateLabels: function(chart) {
                            var out = cats.map(function(c) {
                                var breached = (c.threshold > 0 && c.total > c.threshold);
                                return {
                                    text: c.label,
                                    fillStyle: breached ? breachColor : colorFor(c.key),
                                    strokeStyle: breached ? breachColor : colorFor(c.key),
                                    pointStyle: 'rectRounded',
                                    hidden: false
                                };
                            });
                            out.push({
                                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Chart_Entitlement"].Value)),
                                fillStyle: entitlementColor,
                                strokeStyle: entitlementColor,
                                pointStyle: 'line',
                                lineWidth: 3,
                                hidden: false
                            });
                            return out;
                        }
                    }
                }
            },
            scales: {
                x: { ticks: { font: { size: 11 } } },
                y: { title: { display: true, text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Chart_ObjectCount"].Value)) }, beginAtZero: true }
            }
        }
    });
})();
</script>
}
@if (licHasComposition || licHasExcluded)
{
<script>
(function() {
    if (typeof Chart === 'undefined') { return; }

    var objectCountLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Chart_ObjectCount"].Value));

    function shade(hex, lightenPct) {
        var r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
        r = Math.round(r + (255 - r) * lightenPct);
        g = Math.round(g + (255 - g) * lightenPct);
        b = Math.round(b + (255 - b) * lightenPct);
        return 'rgb(' + r + ',' + g + ',' + b + ')';
    }

    // Draws the running total (with a caption) in the middle of a doughnut.
    var centerTextPlugin = {
        id: 'centerText',
        afterDraw: function(chart) {
            var opts = chart.config.options.plugins.centerText;
            if (!opts) { return; }
            var meta = chart.getDatasetMeta(0);
            if (!meta || !meta.data || !meta.data.length) { return; }
            var el = meta.data[0];
            var cx = el.x, cy = el.y;
            var ctx = chart.ctx;
            ctx.save();
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillStyle = '#111827';
            ctx.font = '700 26px system-ui, sans-serif';
            ctx.fillText(opts.total, cx, cy - 6);
            ctx.fillStyle = '#6b7280';
            ctx.font = '500 12px system-ui, sans-serif';
            ctx.fillText(opts.caption, cx, cy + 16);
            ctx.restore();
        }
    };

    function colorFor(kind, idx) {
        // Blue family = AD domains (enabled / disabled); amber = cloud-only tenants;
        // teal = hybrid; violet = guest.
        var bases = {
            'domain': '#2563eb',
            'domain-disabled': '#2563eb',
            'tenant': '#d97706',
            'tenant-hybrid': '#0d9488',
            'tenant-guest': '#7c3aed'
        };
        return shade(bases[kind] || '#6b7280', (idx % 4) * 0.18);
    }

    function renderDonut(canvasId, segments, total, caption) {
        var canvas = document.getElementById(canvasId);
        if (!canvas || !segments.length) { return; }
        var perKind = {};
        var colors = segments.map(function(s) {
            perKind[s.kind] = (perKind[s.kind] || 0);
            var c = colorFor(s.kind, perKind[s.kind]);
            perKind[s.kind]++;
            return c;
        });
        new Chart(canvas, {
            type: 'doughnut',
            data: {
                labels: segments.map(function(s) { return s.label; }),
                datasets: [{
                    data: segments.map(function(s) { return s.value; }),
                    backgroundColor: colors,
                    borderColor: '#fff',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                cutout: '62%',
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } },
                    centerText: { total: total, caption: caption },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                var v = ctx.parsed;
                                var sum = ctx.dataset.data.reduce(function(a, b) { return a + b; }, 0);
                                var pct = sum ? Math.round(v / sum * 100) : 0;
                                return ctx.label + ': ' + v + ' (' + pct + '%)';
                            }
                        }
                    }
                }
            },
            plugins: [centerTextPlugin]
        });
    }

@if (licHasComposition)
{
<text>
    renderDonut(
        'licensingCompositionChart',
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(licCompSegments.Select(s => new { label = s.label, value = s.value, kind = s.kind }))),
        @licCompTotal,
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Comp_LicensedObjects"].Value))
    );
</text>
}
@if (licHasExcluded)
{
<text>
    renderDonut(
        'licensingExcludedChart',
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(licExclSegments.Select(s => new { label = s.label, value = s.value, kind = s.kind }))),
        @licExclTotal,
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Comp_ExcludedObjects"].Value))
    );
</text>
}
})();
</script>
}
@if (Model.AutoRefreshMinutes > 0)
{
<script>
    setTimeout(function() { document.getElementById('loadingOverlay').classList.add('active'); window.location.reload(); }, @(Model.AutoRefreshMinutes * 60 * 1000));
</script>
}
<script>
    document.getElementById('loadingOverlay').classList.remove('active');
    window.addEventListener('beforeunload', function() {
        if (window.__isExporting) return;
        document.getElementById('loadingOverlay').classList.add('active');
    });
    document.getElementById('btnRefresh').addEventListener('click', function(e) {
        e.preventDefault();
        document.getElementById('loadingOverlay').classList.add('active');
        window.location.reload();
    });
    function toggleCategory(btn) {
        var category = btn.closest('.kpi-category');
        category.classList.toggle('collapsed');
        btn.classList.toggle('collapsed');
        btn.title = category.classList.contains('collapsed') ? 'Expand' : 'Collapse';
    }

    // Licensing has a single KPI (Managed Objects); select it by default so its
    // drill-down chart is shown alongside the entitlements chart on load.
    (function selectDefaultLicensingKpi() {
        if (window.location.hash && window.location.hash.indexOf('#panel-') === 0) return;
        if (typeof openDashboardSection === 'function') {
            openDashboardSection('managedobjects', false);
        }
    })();
</script>
</body>
</html>
