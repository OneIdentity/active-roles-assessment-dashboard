@model ActiveRolesDashboard.Pages.LicensingModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = "Licensing & Compliance";
    Layout = null;

    // Precompute licensing threshold data so the @if blocks below contain only markup
    // (declaring locals/lambdas directly inside an @if{} body can suppress following markup).
    var licHasData = Model.HasLicensingThresholds
        && Model.Summary.ManagedObjects.Error == null
        && Model.Summary.ManagedObjects.DataPoints.Any();
    var licShowPanel = licHasData && Model.KpiSettings.IsKpiEnabled("Licensing", "ManagedObjects");

    var licOverThreshold = false;
    object[] licCategories = System.Array.Empty<object>();
    if (licHasData)
    {
        var licRun = Model.Summary.ManagedObjects.DataPoints.Last();
        System.Func<string, int> licTotal = cat => licRun.Items
            .Where(i => string.Equals(i.Category, cat, StringComparison.OrdinalIgnoreCase))
            .Sum(i => i.Count);
        var licDomain = licTotal("Domain");
        var licPartition = licTotal("Partition");
        // Only cloud-only Entra objects are licensed (hybrid and guests are excluded).
        var licAzure = licRun.Items
            .Where(i => string.Equals(i.Category, "Azure", StringComparison.OrdinalIgnoreCase))
            .Sum(i => i.CloudOnlyCount);
        var licGrand = licDomain + licPartition + licAzure;

        licOverThreshold =
            (Model.LicensedDomainObjects > 0 && licDomain > Model.LicensedDomainObjects)
            || (Model.LicensedPartitionObjects > 0 && licPartition > Model.LicensedPartitionObjects)
            || (Model.LicensedAzureObjects > 0 && licAzure > Model.LicensedAzureObjects)
            || (Model.LicensedTotalObjects > 0 && licGrand > Model.LicensedTotalObjects);

        licCategories = new object[]
        {
            new { key = "Domain", label = Localizer["Cat_Domain"].Value, total = licDomain, threshold = Model.LicensedDomainObjects },
            new { key = "Partition", label = Localizer["Cat_Partition"].Value, total = licPartition, threshold = Model.LicensedPartitionObjects },
            new { key = "Azure", label = Localizer["Cat_Azure"].Value, total = licAzure, threshold = Model.LicensedAzureObjects },
            new { key = "Total", label = Localizer["Cat_GrandTotal"].Value, total = licGrand, threshold = Model.LicensedTotalObjects }
        };
    }

    // Licensing composition: per-AD-domain enabled users (KPI-derived) + per-Entra-tenant
    // cloud-only objects (statistics-derived). These are the objects that consume licences.
    var licCompSegments = new System.Collections.Generic.List<(string label, int value, string kind)>();
    var licHasComposition = false;
    var licCompTotal = 0;
    // Excluded from licensing: disabled AD users (per domain) + Entra hybrid + Entra guest (per tenant).
    var licExclSegments = new System.Collections.Generic.List<(string label, int value, string kind)>();
    var licHasExcluded = false;
    var licExclTotal = 0;
    {
        // Per-AD-domain enabled users. Prefer the KPI-derived enabled-user detail (grouped by
        // domain); if that KPI is unavailable, fall back to the statistics "Domain" category counts
        // so the composition still reflects the licensed AD objects. Only MANAGED enabled users
        // consume a licence; enabled users excluded from the managed scope are counted separately.
        var addedDomainFromKpi = false;
        if (Model.Summary.EnabledUsers?.Items != null && Model.Summary.EnabledUsers.Items.Any())
        {
            foreach (var g in Model.Summary.EnabledUsers.Items
                .Where(i => i.IsManaged)
                .GroupBy(i => string.IsNullOrWhiteSpace(i.Domain) ? "(unknown)" : i.Domain)
                .OrderByDescending(g => g.Count()))
            {
                licCompSegments.Add((g.Key, g.Count(), "domain"));
                addedDomainFromKpi = true;
            }

            // Enabled AD users excluded from the managed scope are not licensed.
            var adExcludedFromMgmt = Model.Summary.EnabledUsers.Items.Count(i => !i.IsManaged);
            if (adExcludedFromMgmt > 0)
            {
                licExclSegments.Add((Localizer["Sub_ExcludedFromManagement"].Value + " \u2014 " + Localizer["Sub_ActiveDirectory"].Value, adExcludedFromMgmt, "excluded-mgmt"));
            }
        }

        // Excluded: disabled AD users per domain.
        if (Model.Summary.DisabledUsers?.Items != null && Model.Summary.DisabledUsers.Items.Any())
        {
            foreach (var g in Model.Summary.DisabledUsers.Items
                .GroupBy(i => string.IsNullOrWhiteSpace(i.Domain) ? "(unknown)" : i.Domain)
                .OrderByDescending(g => g.Count()))
            {
                licExclSegments.Add((g.Key, g.Count(), "domain-disabled"));
            }
        }

        if (Model.Summary.ManagedObjects.DataPoints.Any())
        {
            // Use the latest snapshot that actually carries managed-object items.
            var compRun = Model.Summary.ManagedObjects.DataPoints
                .LastOrDefault(dp => dp.Items != null && dp.Items.Any())
                ?? Model.Summary.ManagedObjects.DataPoints.Last();

            if (!addedDomainFromKpi)
            {
                foreach (var d in compRun.Items
                    .Where(i => string.Equals(i.Category, "Domain", StringComparison.OrdinalIgnoreCase) && i.Count > 0)
                    .OrderByDescending(i => i.Count))
                {
                    licCompSegments.Add((d.DisplayName, d.Count, "domain"));
                }
            }

            var azureItems = compRun.Items
                .Where(i => string.Equals(i.Category, "Azure", StringComparison.OrdinalIgnoreCase))
                .ToList();

            // Licensed: cloud-only per tenant.
            foreach (var t in azureItems
                .Where(i => i.CloudOnlyCount > 0)
                .OrderByDescending(i => i.CloudOnlyCount))
            {
                licCompSegments.Add((t.DisplayName, t.CloudOnlyCount, "tenant"));
            }

            // Excluded: hybrid and guest per tenant.
            foreach (var t in azureItems.Where(i => i.HybridCount > 0).OrderByDescending(i => i.HybridCount))
            {
                licExclSegments.Add((t.DisplayName + " \u2014 " + Localizer["Sub_Hybrid"].Value, t.HybridCount, "tenant-hybrid"));
            }
            foreach (var t in azureItems.Where(i => i.GuestCount > 0).OrderByDescending(i => i.GuestCount))
            {
                licExclSegments.Add((t.DisplayName + " \u2014 " + Localizer["Sub_Guest"].Value, t.GuestCount, "tenant-guest"));
            }
        }

        // Entra cloud-only users excluded from the managed scope are not licensed. The statistics
        // CloudOnlyCount cannot express managed-scope exclusion, so derive the excluded count from
        // the Entra user KPI data (which carries per-user managed status) and move it to the
        // excluded chart while trimming the licensed cloud-only total accordingly.
        if (Model.Summary.EntraTotals?.Error == null)
        {
            var cloudOnly = Model.Summary.EntraTotals.EntraUsers(onPremSynced: false).Items;
            var entraExcludedFromMgmt = cloudOnly.Count(i => !i.IsManaged);
            if (entraExcludedFromMgmt > 0)
            {
                // Remove the excluded cloud-only objects from the licensed tenant segments (largest first).
                var remaining = entraExcludedFromMgmt;
                for (var idx = 0; idx < licCompSegments.Count && remaining > 0; idx++)
                {
                    if (licCompSegments[idx].kind != "tenant") continue;
                    var take = System.Math.Min(remaining, licCompSegments[idx].value);
                    licCompSegments[idx] = (licCompSegments[idx].label, licCompSegments[idx].value - take, licCompSegments[idx].kind);
                    remaining -= take;
                }
                licCompSegments.RemoveAll(s => s.kind == "tenant" && s.value <= 0);
                licExclSegments.Add((Localizer["Sub_ExcludedFromManagement"].Value + " \u2014 " + Localizer["Sub_CloudOnly"].Value, entraExcludedFromMgmt, "excluded-mgmt"));
            }
        }
        licHasComposition = licCompSegments.Count > 0;
        licCompTotal = licCompSegments.Sum(s => s.value);
        licHasExcluded = licExclSegments.Count > 0;
        licExclTotal = licExclSegments.Sum(s => s.value);
    }
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
