@page
@model ActiveRolesDashboard.Pages.SettingsModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = "Settings";
    Layout = null;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Active Roles Dashboard - Settings</title>
    <link rel="stylesheet" href="css/dashboard.css" asp-append-version="true" />
    <style>
        .settings-card { background: #fff; border-radius: 12px; padding: 32px; box-shadow: 0 1px 3px rgba(0,0,0,.08); max-width: 600px; margin: 0 auto 24px; }
        .settings-card h2 { font-size: 1.1rem; font-weight: 600; color: #111827; margin-bottom: 20px; }
        .form-group { margin-bottom: 18px; }
        .form-group label { display: block; font-size: .82rem; font-weight: 600; color: #374151; margin-bottom: 6px; }
        .form-group input[type="number"] { width: 100%; padding: 10px 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: .9rem; outline: none; transition: border-color .2s; }
        .form-group input[type="number"]:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
        .form-group input[type="text"] { width: 100%; padding: 10px 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: .9rem; outline: none; transition: border-color .2s; }
        .form-group input[type="text"]:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
        .form-group .hint { font-size: .75rem; color: #6b7280; margin-top: 4px; }
        .btn-save { width: 100%; padding: 12px; background: #2563eb; color: #fff; border: none; border-radius: 8px; font-size: .9rem; font-weight: 600; cursor: pointer; transition: background .2s; }
        .btn-save:hover { background: #1d4ed8; }
        .msg { margin-top: 14px; padding: 10px 14px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; font-size: .82rem; color: #065f46; }
        .back-link { display: inline-block; margin-bottom: 18px; font-size: .82rem; color: #2563eb; text-decoration: none; }
        .back-link:hover { text-decoration: underline; }
        .kpi-section { margin-bottom: 20px; }
        .kpi-section h3 { font-size: .92rem; font-weight: 600; color: #374151; margin-bottom: 10px; padding-bottom: 6px; border-bottom: 1px solid #e5e7eb; }
        .toggle-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #f3f4f6; }
        .toggle-row:last-child { border-bottom: none; }
        .toggle-row .toggle-label { font-size: .84rem; color: #374151; }
        .toggle-row .toggle-label.category-label { font-weight: 700; }
        .toggle-switch { position: relative; width: 44px; height: 24px; flex-shrink: 0; }
        .toggle-switch input { opacity: 0; width: 0; height: 0; }
        .toggle-slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background: #d1d5db; border-radius: 24px; transition: .2s; }
        .toggle-slider:before { content: ""; position: absolute; height: 18px; width: 18px; left: 3px; bottom: 3px; background: #fff; border-radius: 50%; transition: .2s; }
        .toggle-switch input:checked + .toggle-slider { background: #2563eb; }
        .toggle-switch input:checked + .toggle-slider:before { transform: translateX(20px); }
        .kpi-items { padding-left: 20px; }

        .section-header { display: flex; align-items: center; justify-content: space-between; cursor: pointer; user-select: none; margin-bottom: 0; }
        .section-header h2 { margin-bottom: 0; }
        .section-toggle { background: none; border: none; cursor: pointer; padding: 4px 8px; font-size: 1.2rem; color: #6b7280; transition: transform .2s; display: flex; align-items: center; }
        .section-toggle svg { width: 20px; height: 20px; transition: transform .2s; }
        .section-header.collapsed .section-toggle svg { transform: rotate(-90deg); }
        .section-body { overflow: hidden; transition: max-height .3s ease, opacity .2s ease; max-height: 2000px; opacity: 1; }
        .section-body.collapsed { max-height: 0; opacity: 0; margin-top: 0; }
        .section-body:not(.collapsed) { margin-top: 20px; }
        .lang-select-wrap { display: flex; align-items: center; gap: 10px; }
        .lang-flag { width: 24px; height: 16px; border-radius: 2px; object-fit: cover; box-shadow: 0 0 0 1px rgba(0,0,0,.08); flex-shrink: 0; }
        .lang-select { flex: 1; padding: 10px 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: .9rem; outline: none; background: #fff; transition: border-color .2s; }
        .lang-select:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
    </style>
</head>
<body>
<div class="page">
    @{
        ViewData["HeaderKey"] = "Settings";
        ViewData["HeaderRight"] = "signout";
    }
    <partial name="_DashboardHeader" />

    <a href="@(HttpContext.Request.PathBase)/" class="back-link" id="backLink">&larr; @Localizer["BackToDashboard"]</a>

    <form method="post">
        <div class="settings-card">
            <div class="section-header collapsed" onclick="toggleSection(this)">
                <h2>@Localizer["Card_WebInterface"]</h2>
                <button type="button" class="section-toggle"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button>
            </div>
            <div class="section-body collapsed">
                <div class="form-group">
                    <label for="WebInterfaceUrl">@Localizer["Label_BaseUrl"]</label>
                    <input type="text" id="WebInterfaceUrl" name="WebInterfaceUrl" value="@Model.WebInterfaceUrl" placeholder="https://server/arWebAdmin" />
                    <p class="hint">@Localizer["Hint_WebInterface"]</p>
                </div>
            </div>
        </div>

        <div class="settings-card">
            <div class="section-header collapsed" onclick="toggleSection(this)">
                <h2>@Localizer["Card_AutoRefresh"]</h2>
                <button type="button" class="section-toggle"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button>
            </div>
            <div class="section-body collapsed">
                <div class="form-group">
                    <label for="AutoRefreshMinutes">@Localizer["Label_RefreshInterval"]</label>
                    <input type="number" id="AutoRefreshMinutes" name="AutoRefreshMinutes" value="@Model.AutoRefreshMinutes" min="0" max="1440" />
                    <p class="hint">@Localizer["Hint_AutoRefresh"]</p>
                </div>
            </div>
        </div>

        <div class="settings-card">
            <div class="section-header collapsed" onclick="toggleSection(this)">
                <h2>@Localizer["Card_Language"]</h2>
                <button type="button" class="section-toggle"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button>
            </div>
            <div class="section-body collapsed">
                <div class="form-group">
                    <label for="Language">@Localizer["Label_DisplayLanguage"]</label>
                    <div class="lang-select-wrap">
                        <img id="langFlag" class="lang-flag" src="@(HttpContext.Request.PathBase)/@(Model.SelectedLanguage.FlagImage)" alt="@Model.SelectedLanguage.DisplayName flag" />
                        <select id="Language" name="Language" class="lang-select" onchange="updateLangFlag(this)">
                            @foreach (var lang in Model.Languages)
                            {
                                <option value="@lang.Code" data-flag="@(HttpContext.Request.PathBase)/@(lang.FlagImage)" selected="@(lang.Code == Model.Language)">@lang.DisplayName</option>
                            }
                        </select>
                    </div>
                    <p class="hint">@Localizer["Hint_Language"]</p>
                </div>
            </div>
        </div>

        <div class="settings-card">
            <div class="section-header collapsed" onclick="toggleSection(this)">
                <h2>@Localizer["Card_KpiConfiguration"]</h2>
                <button type="button" class="section-toggle"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button>
            </div>
            <div class="section-body collapsed">

            @if (Model.IsActiveRolesAdmin)
            {
            <div class="form-group">
                <label for="CustomActiveRolesAdminsBaseDn">@Localizer["Label_ArAdminsBaseDn"]</label>
                <input type="text" id="CustomActiveRolesAdminsBaseDn" name="CustomActiveRolesAdminsBaseDn" value="@Model.CustomActiveRolesAdminsBaseDn" placeholder="@Model.Defaults.DefaultActiveDirectoryDN" />
            </div>
            <div class="form-group">
                <label for="CustomActiveRolesAdminsFilter">@Localizer["Label_ArAdminsFilter"]</label>
                <input type="text" id="CustomActiveRolesAdminsFilter" name="CustomActiveRolesAdminsFilter" value="@Model.CustomActiveRolesAdminsFilter" placeholder="@Model.Defaults.DefaultActiveRolesAdminsFilter" />
            </div>
            }
            <div class="form-group">
                <label for="CustomNoGroupOwnerBaseDn">@Localizer["Label_NoGroupOwnerBaseDn"]</label>
                <input type="text" id="CustomNoGroupOwnerBaseDn" name="CustomNoGroupOwnerBaseDn" value="@Model.CustomNoGroupOwnerBaseDn" placeholder="@Model.Defaults.DefaultActiveDirectoryDN" />
            </div>
            <div class="form-group">
                <label for="CustomNoManagerUserBaseDn">@Localizer["Label_NoManagerUserBaseDn"]</label>
                <input type="text" id="CustomNoManagerUserBaseDn" name="CustomNoManagerUserBaseDn" value="@Model.CustomNoManagerUserBaseDn" placeholder="@Model.Defaults.DefaultActiveDirectoryDN" />
            </div>
            <div class="form-group">
                <label for="CustomNoManagerUserFilter">@Localizer["Label_NoManagerUserFilter"]</label>
                <input type="text" id="CustomNoManagerUserFilter" name="CustomNoManagerUserFilter" value="@Model.CustomNoManagerUserFilter" placeholder="@Model.Defaults.DefaultNoManagerUserFilter" />
            </div>
            <div class="form-group">
                <label for="CustomNoManagerServiceAccountBaseDn">@Localizer["Label_NoManagerSvcBaseDn"]</label>
                <input type="text" id="CustomNoManagerServiceAccountBaseDn" name="CustomNoManagerServiceAccountBaseDn" value="@Model.CustomNoManagerServiceAccountBaseDn" placeholder="@Model.Defaults.DefaultActiveDirectoryDN" />
            </div>
            <div class="form-group">
                <label for="CustomNoManagerServiceAccountFilter">@Localizer["Label_NoManagerSvcFilter"]</label>
                <input type="text" id="CustomNoManagerServiceAccountFilter" name="CustomNoManagerServiceAccountFilter" value="@Model.CustomNoManagerServiceAccountFilter" placeholder="@Model.Defaults.DefaultNoManagerServiceAccountFilter" />
            </div>
            <div class="form-group">
                <label for="CustomUserAccountLockedOutBaseDn">@Localizer["Label_LockedOutBaseDn"]</label>
                <input type="text" id="CustomUserAccountLockedOutBaseDn" name="CustomUserAccountLockedOutBaseDn" value="@Model.CustomUserAccountLockedOutBaseDn" placeholder="@Model.Defaults.DefaultActiveDirectoryDN" />
            </div>
            <div class="form-group">
                <label for="CustomEmptyGroupsBaseDn">@Localizer["Label_EmptyGroupsBaseDn"]</label>
                <input type="text" id="CustomEmptyGroupsBaseDn" name="CustomEmptyGroupsBaseDn" value="@Model.CustomEmptyGroupsBaseDn" placeholder="@Model.Defaults.DefaultActiveDirectoryDN" />
            </div>
            <div class="form-group">
                <label for="EntraLargeGroupMemberThreshold">@Localizer["Label_LargeGroupThreshold"]</label>
                <input type="number" id="EntraLargeGroupMemberThreshold" name="EntraLargeGroupMemberThreshold" value="@Model.EntraLargeGroupMemberThreshold" min="1" max="100000" />
                <p class="hint">@Localizer["Hint_LargeGroupThreshold"]</p>
            </div>
            </div>
        </div>

        <div class="settings-card">
            <div class="section-header collapsed" onclick="toggleSection(this)">
                <h2>@Localizer["Card_KpiVisibility"]</h2>
                <button type="button" class="section-toggle"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button>
            </div>
            <div class="section-body collapsed">

            <div class="kpi-section">
                <div class="toggle-row">
                    <span class="toggle-label category-label">@CategoryInfo.Overview.DisplayName</span>
                    <label class="toggle-switch">
                        <input type="checkbox" name="KpiSettings.OverviewEnabled" value="true" @(Model.KpiSettings.OverviewEnabled ? "checked" : "") />
                        <span class="toggle-slider"></span>
                    </label>
                    <input type="hidden" name="KpiSettings.OverviewEnabled" value="false" />
                </div>
            </div>

            @if (Model.IsActiveRolesAdmin)
            {
            <div class="kpi-section">
                <div class="toggle-row">
                    <span class="toggle-label category-label">@CategoryInfo.ARConfiguration.DisplayName</span>
                    <label class="toggle-switch">
                        <input type="checkbox" name="KpiSettings.ARConfigurationEnabled" value="true" @(Model.KpiSettings.ARConfigurationEnabled ? "checked" : "") />
                        <span class="toggle-slider"></span>
                    </label>
                    <input type="hidden" name="KpiSettings.ARConfigurationEnabled" value="false" />
                </div>
                <div class="kpi-items">
                    <div class="toggle-row">
                        <span class="toggle-label">Active Roles Admins</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.ActiveRolesAdminsEnabled" value="true" @(Model.KpiSettings.ActiveRolesAdminsEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.ActiveRolesAdminsEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">Managed Domains</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.DomainsEnabled" value="true" @(Model.KpiSettings.DomainsEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.DomainsEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">AR Servers</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.ServersEnabled" value="true" @(Model.KpiSettings.ServersEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.ServersEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">Access Templates</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.AccessTemplatesEnabled" value="true" @(Model.KpiSettings.AccessTemplatesEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.AccessTemplatesEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">Access Template Links</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.AccessTemplateLinksEnabled" value="true" @(Model.KpiSettings.AccessTemplateLinksEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.AccessTemplateLinksEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">Dynamic Groups</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.DynamicGroupsEnabled" value="true" @(Model.KpiSettings.DynamicGroupsEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.DynamicGroupsEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">Group Families</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.GroupFamiliesEnabled" value="true" @(Model.KpiSettings.GroupFamiliesEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.GroupFamiliesEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">Managed Units</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.ManagedUnitsEnabled" value="true" @(Model.KpiSettings.ManagedUnitsEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.ManagedUnitsEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">Policy Object Links</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.PolicyObjectLinksEnabled" value="true" @(Model.KpiSettings.PolicyObjectLinksEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.PolicyObjectLinksEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">Policy Objects</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.PolicyObjectsEnabled" value="true" @(Model.KpiSettings.PolicyObjectsEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.PolicyObjectsEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">Virtual Attributes</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.VirtualAttributesEnabled" value="true" @(Model.KpiSettings.VirtualAttributesEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.VirtualAttributesEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">Config Databases</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.ConfigDatabasesEnabled" value="true" @(Model.KpiSettings.ConfigDatabasesEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.ConfigDatabasesEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">History Databases</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.HistoryDatabasesEnabled" value="true" @(Model.KpiSettings.HistoryDatabasesEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.HistoryDatabasesEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">Workflows</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.WorkflowsEnabled" value="true" @(Model.KpiSettings.WorkflowsEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.WorkflowsEnabled" value="false" />
                    </div>
                </div>
            </div>
            }

            <div class="kpi-section">
                <div class="toggle-row">
                    <span class="toggle-label category-label">@CategoryInfo.ADGovernance.DisplayName</span>
                    <label class="toggle-switch">
                        <input type="checkbox" name="KpiSettings.ADGovernanceEnabled" value="true" @(Model.KpiSettings.ADGovernanceEnabled ? "checked" : "") />
                        <span class="toggle-slider"></span>
                    </label>
                    <input type="hidden" name="KpiSettings.ADGovernanceEnabled" value="false" />
                </div>
                <div class="kpi-items">
                    <div class="toggle-row">
                        <span class="toggle-label">No Group Owner</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.NoGroupOwnerEnabled" value="true" @(Model.KpiSettings.NoGroupOwnerEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.NoGroupOwnerEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">No Manager (User)</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.NoManagerUserEnabled" value="true" @(Model.KpiSettings.NoManagerUserEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.NoManagerUserEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">No Manager (Service Account)</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.NoManagerServiceAccountEnabled" value="true" @(Model.KpiSettings.NoManagerServiceAccountEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.NoManagerServiceAccountEnabled" value="false" />
                    </div>

                    <div class="toggle-row">
                        <span class="toggle-label">Service Accounts</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.ServiceAccountsEnabled" value="true" @(Model.KpiSettings.ServiceAccountsEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.ServiceAccountsEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">gMSA Service Accounts</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.GmsaServiceAccountsEnabled" value="true" @(Model.KpiSettings.GmsaServiceAccountsEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.GmsaServiceAccountsEnabled" value="false" />
                    </div>

                    <div class="toggle-row">
                        <span class="toggle-label">sMSA Service Accounts</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.SmsaServiceAccountsEnabled" value="true" @(Model.KpiSettings.SmsaServiceAccountsEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.SmsaServiceAccountsEnabled" value="false" />
                    </div>

                    <div class="toggle-row">
                        <span class="toggle-label">User Account Locked Out</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.UserAccountLockedOutEnabled" value="true" @(Model.KpiSettings.UserAccountLockedOutEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.UserAccountLockedOutEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">Empty Groups</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.EmptyGroupsEnabled" value="true" @(Model.KpiSettings.EmptyGroupsEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.EmptyGroupsEnabled" value="false" />
                    </div>
                    <div class="toggle-row">
                        <span class="toggle-label">Never Logged In</span>
                        <label class="toggle-switch">
                            <input type="checkbox" name="KpiSettings.NeverLoggedInEnabled" value="true" @(Model.KpiSettings.NeverLoggedInEnabled ? "checked" : "") />
                            <span class="toggle-slider"></span>
                        </label>
                        <input type="hidden" name="KpiSettings.NeverLoggedInEnabled" value="false" />
                    </div>
                </div>
            </div>

            <div class="kpi-section">
                <div class="toggle-row">
                    <span class="toggle-label category-label">@CategoryInfo.EntraIDGovernance.DisplayName</span>
                    <label class="toggle-switch">
                        <input type="checkbox" name="KpiSettings.EntraIDGovernanceEnabled" value="true" @(Model.KpiSettings.EntraIDGovernanceEnabled ? "checked" : "") />
                        <span class="toggle-slider"></span>
                    </label>
                    <input type="hidden" name="KpiSettings.EntraIDGovernanceEnabled" value="false" />
                </div>
                <div class="kpi-items">
                    <p class="muted" style="padding: 8px 0; font-size: .84rem;">No KPIs configured yet.</p>
                </div>
            </div>

            <div class="kpi-section">
                <div class="toggle-row">
                    <span class="toggle-label category-label">@CategoryInfo.EntraUserAccounts.DisplayName</span>
                    <label class="toggle-switch">
                        <input type="checkbox" name="KpiSettings.EntraUserAccountsEnabled" value="true" @(Model.KpiSettings.EntraUserAccountsEnabled ? "checked" : "") />
                        <span class="toggle-slider"></span>
                    </label>
                    <input type="hidden" name="KpiSettings.EntraUserAccountsEnabled" value="false" />
                </div>
                <div class="kpi-items">
