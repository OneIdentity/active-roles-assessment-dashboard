<style>
    .loading-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(243,244,246,.92); display: none; align-items: center; justify-content: center; z-index: 2000; }
    .loading-overlay.active { display: flex; }
    .loading-spinner { text-align: center; }
    .loading-spinner p { margin-top: 16px; font-size: .9rem; font-weight: 600; color: #374151; }
    .spinner { width: 40px; height: 40px; margin: 0 auto; border: 4px solid #e5e7eb; border-top-color: #2563eb; border-radius: 50%; animation: spin .8s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>
@await Html.PartialAsync("_AppBaseScript")
<script>
    var settingsChanged = @(Model.SettingsChanged ? "true" : "false");

    document.getElementById('backLink').addEventListener('click', function(e) {
        e.preventDefault();
        if (settingsChanged) {
            document.getElementById('loadingOverlay').classList.add('active');
            window.location.href = appBase + '/';
        } else {
            window.location.href = appBase + '/?cached=true';
        }
    });

    function toggleSection(header) {
        header.classList.toggle('collapsed');
        var body = header.nextElementSibling;
        body.classList.toggle('collapsed');
    }

    function updateLangFlag(select) {
        var opt = select.options[select.selectedIndex];
        var flag = opt.getAttribute('data-flag');
        if (flag) document.getElementById('langFlag').src = flag;
    }
</script>
