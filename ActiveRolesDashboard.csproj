<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>ClientApp\</SpaRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**</DefaultItemExcludes>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
  </PropertyGroup>

  <ItemGroup>
    <!-- The React front end is built separately with Vite (output: wwwroot/app); keep its
         sources and node_modules out of the web project so VS/MSBuild do not process them. -->
    <Content Remove="$(SpaRoot)**" />
    <None Remove="$(SpaRoot)**" />
    <TypeScriptCompile Remove="$(SpaRoot)**" />
  </ItemGroup>

  <ItemGroup>
    <COMReference Include="EDMLib">
      <VersionMinor>0</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>d0ecd291-63e5-4239-8ed6-9309894cbbac</Guid>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
    <COMReference Include="EDMParameters70">
      <VersionMinor>0</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>015a9377-ab1b-47f6-bbe5-57a822324182</Guid>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
    <COMReference Include="ActiveDs">
      <WrapperTool>tlbimp</WrapperTool>
      <VersionMinor>0</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>97d25db0-0363-11cf-abc4-02608c9e7553</Guid>
      <Lcid>0</Lcid>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="ClientApp\src\app\features\dashboard\dashboard.component.html" />
    <Content Include="ClientApp\src\app\features\settings\settings.component.html" />
    <Content Include="ClientApp\src\app\features\setup\setup.component.html" />
    <Content Include="ClientApp\src\app\shared\ui\iris-bar-chart\iris-bar-chart.component.html" />
    <Content Include="ClientApp\src\app\shared\ui\iris-card\iris-card.component.html" />
    <Content Include="ClientApp\src\app\shared\ui\iris-checkbox\iris-checkbox.component.html" />
    <Content Include="ClientApp\src\app\shared\ui\iris-collapsible-section\iris-collapsible-section.component.html" />
    <Content Include="ClientApp\src\app\shared\ui\iris-donut-chart\iris-donut-chart.component.html" />
