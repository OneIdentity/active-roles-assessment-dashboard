<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Cookies" Version="2.3.10" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.8" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="QuestPDF" Version="2026.7.2" />
  </ItemGroup>

  <!-- Exclude the standalone console/validation sub-projects from the web project's
       default source globbing so their files (and generated obj artifacts) are not
       compiled into this assembly. They build as their own projects in the solution. -->
  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <Compile Remove="GraphPerfTest\**\*.cs" />
    <Content Remove="GraphPerfTest\**\*" />
    <None Remove="GraphPerfTest\**\*" />
    <Compile Remove="_validate\**\*.cs" />
    <Content Remove="_validate\**\*" />
    <None Remove="_validate\**\*" />
    <None Include="_validate\_validate.csproj" />
  </ItemGroup>

</Project>
