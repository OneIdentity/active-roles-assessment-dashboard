<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <COMReference Include="EDMLib">
      <VersionMinor>0</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>d0ecd291-63e5-4239-8ed6-9309894cbbac</Guid>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
    <COMReference Include="EDMParameters70">
      <VersionMinor>0</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>015a9377-ab1b-47f6-bbe5-57a822324182</Guid>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
    <COMReference Include="ActiveDs">
      <WrapperTool>tlbimp</WrapperTool>
      <VersionMinor>0</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>97d25db0-0363-11cf-abc4-02608c9e7553</Guid>
      <Lcid>0</Lcid>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Cookies" Version="2.3.10" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.8" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="QuestPDF" Version="2026.7.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
    <PackageReference Include="System.DirectoryServices" Version="10.0.12" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Never publish the local development overrides; they are for local runs only and must
         not ship to a target server (they would override the target's appsettings.json). -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Angular (ClientApp) build integration.
       SpaRoot is the Angular workspace; SpaDist is its browser build output.
       These properties feed the build/publish targets below. -->
  <PropertyGroup>
    <SpaRoot>ClientApp\</SpaRoot>
    <SpaDist>$(SpaRoot)dist\ClientApp\browser\</SpaDist>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the Angular source/build artifacts out of the default content glob so they are
         not copied verbatim; the browser output is added explicitly for publish below. -->
    <Content Remove="$(SpaRoot)**" />
    <None Remove="$(SpaRoot)node_modules\**" />
  </ItemGroup>

  <!-- Restore npm packages when node_modules is missing (fresh clone / CI). -->
  <Target Name="EnsureNpmInstall" BeforeTargets="BuildAngular" Condition="!Exists('$(SpaRoot)node_modules')">
    <Message Importance="high" Text="Restoring npm packages for $(SpaRoot)..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
  </Target>

  <!-- Build the Angular app on Build and Publish so the SPA assets are always current.
       Skipped when SkipAngularBuild=true (e.g. fast inner-loop backend builds). -->
  <Target Name="BuildAngular" BeforeTargets="Build;Publish" Condition="'$(SkipAngularBuild)' != 'true'">
    <Message Importance="high" Text="Building Angular SPA ($(SpaRoot))..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
  </Target>

  <!-- Include the Angular browser build output in the publish package, preserving the
       dist\ClientApp\browser path that Program.cs serves from. -->
  <Target Name="IncludeAngularDistInPublish" AfterTargets="BuildAngular" BeforeTargets="Publish">
    <ItemGroup>
      <_SpaDistFiles Include="$(SpaDist)**" />
      <ResolvedFileToPublish Include="@(_SpaDistFiles)">
        <RelativePath>ClientApp\dist\ClientApp\browser\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
