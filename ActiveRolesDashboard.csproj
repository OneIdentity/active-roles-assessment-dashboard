<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>ClientApp\</SpaRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**</DefaultItemExcludes>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
  </PropertyGroup>

  <ItemGroup>
    <!-- The React front end is built separately with Vite (output: wwwroot/app); keep its
         sources and node_modules out of the web project so VS/MSBuild do not process them. -->
    <Content Remove="$(SpaRoot)**" />
    <None Remove="$(SpaRoot)**" />
    <TypeScriptCompile Remove="$(SpaRoot)**" />
  </ItemGroup>

  <!-- Build the React front end into wwwroot/app. node_modules is restored on first build;
       the Vite bundle is built when it is missing, in Release builds and on publish. During
       day-to-day work run `npm run dev` (Vite dev server) or `npm run build` in ClientApp. -->
  <Target Name="ClientAppNpmInstall" BeforeTargets="Build" Condition="!Exists('$(SpaRoot)node_modules')">
    <Message Importance="high" Text="Restoring ClientApp npm packages..." />
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" />
  </Target>

  <Target Name="ClientAppBuild" AfterTargets="ClientAppNpmInstall" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' Or !Exists('wwwroot\app\index.html')">
    <Message Importance="high" Text="Building ClientApp (Vite)..." />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
  </Target>

  <Target Name="ClientAppPublish" AfterTargets="ComputeFilesToPublish">
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
    <ItemGroup>
      <ClientAppDist Include="wwwroot\app\**" />
      <ResolvedFileToPublish Include="@(ClientAppDist->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\app\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <COMReference Include="EDMLib">
      <VersionMinor>0</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>d0ecd291-63e5-4239-8ed6-9309894cbbac</Guid>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
    <COMReference Include="EDMParameters70">
      <VersionMinor>0</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>015a9377-ab1b-47f6-bbe5-57a822324182</Guid>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
    <COMReference Include="ActiveDs">
      <WrapperTool>tlbimp</WrapperTool>
      <VersionMinor>0</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>97d25db0-0363-11cf-abc4-02608c9e7553</Guid>
      <Lcid>0</Lcid>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Cookies" Version="2.3.10" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.8" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="QuestPDF" Version="2026.7.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
    <PackageReference Include="System.DirectoryServices" Version="10.0.12" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include="ClientApp\src\ux\images\figma-privacy.svg" />
    <None Include="ClientApp\src\ux\images\figma-signout.svg" />
  </ItemGroup>

  <ItemGroup>
    <!-- Never publish the local development overrides; they are for local runs only and must
         not ship to a target server (they would override the target's appsettings.json). -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
